{
  "manifest_version": 2,
  "id": "local.maimai-agent-bridge",
  "version": "0.5.0",
  "name": "麦麦 Agent 桥接",
  "description": "扫描本机和 Conda Codex，连接 SSH/WebSocket 实例与 A2A Agent，管理 session 索引、模型和后台任务",
  "author": {"name": "lanchoxie", "url": "https://github.com/lanchoxie"},
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/lanchoxie/maimai-agent-bridge",
    "documentation": "https://github.com/lanchoxie/maimai-agent-bridge/blob/main/README.md",
    "issues": "https://github.com/lanchoxie/maimai-agent-bridge/issues"
  },
  "host_application": {"min_version": "1.3.9", "max_version": "1.3.99"},
  "sdk": {"min_version": "2.12.0", "max_version": "2.99.99"},
  "dependencies": [{"type": "python_package", "name": "httpx", "version_spec": ">=0.27,<1"}, {"type": "python_package", "name": "websockets", "version_spec": ">=15,<17"}],
  "capabilities": ["send.text", "send.custom"],
  "i18n": {"default_locale": "zh-CN"}
}
